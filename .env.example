# ═══════════════════════════════════════════════════════════════════════════
#  Satori — environment template (SHAREABLE — contains no real secrets)
# ─────────────────────────────────────────────────────────────────────────────
#  HOW TO USE
#    1. Copy this file to  backend/.env  (the backend calls load_dotenv() at
#       startup, which reads a file literally named ".env" — this template
#       itself is never loaded).
#    2. Fill in real values. NEVER commit the filled-in .env — .gitignore
#       already excludes .env and .env.* (only this .env.example is tracked).
#
#  In production (Cloud Run service `satori-v2`, project capability-agent-prod)
#  these are set as service env vars / Secret Manager secrets — the deploy
#  pipeline preserves them; no .env file is used there.
# ═══════════════════════════════════════════════════════════════════════════


# ── BigQuery warehouse ───────────────────────────────────────────────────────
# GCP project + dataset holding the TMC data (Employee_Data, Attendance_Data,
# Allocation_Data, Timesheet_Data, Project_Master, WP_Report, Sales_*).
VERTEX_PROJECT=capability-agent-prod
VERTEX_DATASET=Satori_Project
VERTEX_LOCATION=us-central1
# Recommended for local dev: DON'T set GOOGLE_APPLICATION_CREDENTIALS — run
#   gcloud auth application-default login
# and BigQuery uses those credentials automatically (ADC). Only set a
# service-account key path if you must; on Cloud Run the runtime service
# account is used and this stays unset.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json

# ── AI (Google Gemini) ───────────────────────────────────────────────────────
# Required — powers chat, dashboards, reports, voice, and the self-heal loop.
GEMINI_API_KEY=your-gemini-api-key
# Set USE_VERTEX_AI=1 to route Gemini through Vertex AI (uses VERTEX_PROJECT
# + VERTEX_LOCATION) instead of the public API key.
USE_VERTEX_AI=0
# Optional voice-agent overrides (sensible defaults exist in code).
GEMINI_MODEL_VOICE=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=Leda

# ── Auth & security ──────────────────────────────────────────────────────────
# Secret for signing login JWTs — generate a long random string per env.
JWT_SECRET=change-me-long-random-string
# Fernet key encrypting users' TOTP 2FA secrets at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=change-me-fernet-key
# Bootstrap superadmin email (the in-code _SUPERADMIN_EMAILS allowlist is the
# real gate; this is the legacy bootstrap account address).
SUPERADMIN_EMAIL=superadmin@tmc.com
# DEV ONLY — set to 1 to skip 2FA prompts locally. NEVER in production.
BYPASS_OTP=0
# Comma-separated CORS origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# ── Application database (users, dashboards, reports, feedback…) ────────────
# Leave ALL of these empty to use local SQLite (growgnition.db) — the default
# for development. Set them for Postgres / Cloud SQL in production.
CLOUD_SQL_CONNECTION_NAME=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Email (password resets, subscriptions, support/feedback alerts) ─────────
# Gmail/Workspace SMTP with an App Password (spaces stripped).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@yourdomain.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-sender@yourdomain.com
SMTP_FROM_NAME=Satori
# Public base URL of the app — used to build https reset/share links.
APP_BASE_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Where in-app support tickets / flagged AI feedback get emailed (optional).
SUPPORT_EMAIL_TO=
FEEDBACK_FLAG_EMAIL_TO=

# ── Google integration (per-user Calendar + Gmail, OAuth) ────────────────────
# OAuth client from GCP Console → APIs & Services → Credentials. Leave the
# redirect unset to auto-derive it from the request host; if set explicitly it
# must point at the real callback route below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# ── Machine endpoints (optional) ─────────────────────────────────────────────
# Bearer token for the internal scheduled-subscriptions runner endpoint.
SUBSCRIPTIONS_CRON_TOKEN=
# Token gating the public no-login usage dashboard link.
USAGE_PORTAL_TOKEN=

# ── Drive→BigQuery pipeline (pipeline/drive_to_bq.py — Cloud Run Job only) ──
# Shared Drive folder the 30-min sync reads CSVs from.
DRIVE_FOLDER_ID=
# Set DRY_RUN=1 to inspect CSV headers without loading anything.
DRY_RUN=0

# ── Frontend (frontend/.env — Vite reads VITE_* at build time) ──────────────
# Base URL of the backend API. Empty string = same origin (production build
# served by the backend). For local dev against a local API:
VITE_API_BASE=http://localhost:8000
